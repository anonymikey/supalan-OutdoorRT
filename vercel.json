{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://anonymikeconnect-mpw.onrender.com/api/:path*"
    },
    {
      "source": "/outdoor-wifi",
      "destination": "/outdoor-wifi.html"
    },
    {
      "source": "/admin/expiry",
      "destination": "/admin-expiry.html"
    },
    {
      "source": "/admin/outdoor-wifi",
      "destination": "/admin-outdoor-wifi.html"
    },
    {
      "source": "/admin/sms",
      "destination": "/admin-sms.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/",
      "destination": "/login.html"
    }
  ]
}
